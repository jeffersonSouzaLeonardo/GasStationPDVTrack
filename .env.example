# PDV Application Environment Configuration
# Copy this file to .env and adjust values as needed

# Database Configuration (MySQL)
# Connection URL format: jdbc:mysql://host:port/database
DB_URL=jdbc:mysql://localhost:3306/pdvtrack?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=root

# Spring Profiles (dev, prod, test)
SPRING_PROFILES_ACTIVE=dev

# Optional: Enable verbose logging for database operations
# LOGGING_LEVEL_COM_ZAXXER_HIKARI=DEBUG
# LOGGING_LEVEL_ORG_HIBERNATE_SQL=DEBUG
