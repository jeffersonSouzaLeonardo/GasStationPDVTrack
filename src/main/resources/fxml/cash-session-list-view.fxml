<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane fx:id="root" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.br.manager.domain.shift.controller.CashSessionListController">
    <VBox styleClass="card" spacing="16" maxWidth="980" maxHeight="-Infinity">
        <Label text="Caixas" styleClass="page-title"/>
        <HBox spacing="12" alignment="CENTER_LEFT">
            <Button text="Novo Caixa" styleClass="primary-button" onAction="#onNewCashier"/>
            <Button text="Atualizar" styleClass="secondary-button" onAction="#onRefresh"/>
        </HBox>
        <TableView fx:id="sessionTable" VBox.vgrow="ALWAYS" prefHeight="420">
            <columns>
                <TableColumn fx:id="numberColumn" text="Caixa" prefWidth="70"/>
                <TableColumn fx:id="shiftColumn" text="Turno" prefWidth="160"/>
                <TableColumn fx:id="openedByColumn" text="Aberto por" prefWidth="140"/>
                <TableColumn fx:id="closedByColumn" text="Fechado por" prefWidth="140"/>
                <TableColumn fx:id="openedAtColumn" text="Abertura" prefWidth="130"/>
                <TableColumn fx:id="closedAtColumn" text="Fechamento" prefWidth="130"/>
                <TableColumn fx:id="statusColumn" text="Status" prefWidth="90"/>
                <TableColumn fx:id="actionColumn" text="" prefWidth="90"/>
            </columns>
        </TableView>
    </VBox>
</StackPane>
