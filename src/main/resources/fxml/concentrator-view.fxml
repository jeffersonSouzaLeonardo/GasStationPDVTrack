<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane fx:id="root" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.br.manager.domain.integration.controller.ConcentratorController">
    <VBox styleClass="card" alignment="CENTER" spacing="20" maxWidth="420" maxHeight="-Infinity">
        <Label text="Concentrador" styleClass="page-title"/>
        <Label fx:id="statusLabel" styleClass="status-disconnected"/>
        <Label fx:id="lastFuelingLabel" text="Nenhum abastecimento lido"/>
        <Button fx:id="connectButton" text="Conectar" styleClass="primary-button" onAction="#onConnect"/>
        <Button text="Fechar" styleClass="secondary-button" onAction="#onClose"/>
    </VBox>
</StackPane>
